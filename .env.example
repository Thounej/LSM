# Copy this file to ".env" and fill in the real values.
# .env is gitignored - never commit real credentials.

# Nadeo dedicated-server ("service_...") account, reused from Illan Cup Medals.
TM_SERVICE_LOGIN=
TM_SERVICE_PASSWORD=

# Latitude club + the speedmapping folder inside it.
CLUB_ID=97497
FOLDER_ID=866418

# Cloudflare: account id, an API token with KV write access, and the
# namespace id of the "LSM" KV namespace.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
